# ---------------- Sunwai backend (api/) ----------------
# Copy to .env (repo root) or api/.env. Never commit the real file.

# 1 = no network at all: LLMs answered by recorded fixtures / the deterministic mock brain,
#     TinyFish runs replayed from recorded SSE fixtures. The demo safety net.
MOCK_MODE=1
# Replay speed for mock agent runs (1 = realistic, 0 = instant)
MOCK_DELAY_SCALE=1
# 1 = save every live LLM output and raw TinyFish stream as fixtures
RECORD_FIXTURES=0

DATABASE_URL=sqlite:///./sunwai.db
# Comma-separated frontend origins allowed by CORS (scheme + host + port)
CORS_ORIGINS=http://localhost:3000
# Public HTTPS URL of the frontend that serves /sandbox/grievance and /sandbox/status (TinyFish must reach it)
SANDBOX_PUBLIC_URL=https://your-app.vercel.app
# Optional: pin "real today" for rehearsals (YYYY-MM-DD). The demo clock offset is added on top.
DEMO_BASE_DATE=

# ---------------- TinyFish ----------------
TINYFISH_API_KEY=
TINYFISH_SEARCH_LOCATION=IN
# Set to IN to route live portal runs through an Indian exit (falls back to no proxy if rejected)
TINYFISH_PROXY_COUNTRY=
TINYFISH_BROWSER_PROFILE=lite

# ---------------- LLMs (OpenAI-compatible; one OpenRouter key works for all three) ----------------
# OPENROUTER_API_KEY is used for any provider below whose own *_API_KEY is empty.
OPENROUTER_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash        # confirm with GET /models (startup logs a warning if missing)
DEEPSEEK_VISION=0
GLM_BASE_URL=https://openrouter.ai/api/v1
GLM_API_KEY=
GLM_MODEL=z-ai/glm-5.3-flash
GLM_VISION=0                                      # set 1 if this model reads screenshots
NEMOTRON_BASE_URL=https://openrouter.ai/api/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning
NEMOTRON_VISION=0

# Fallback chains per role (provider names, first = primary)
ROLE_INTAKE=glm,deepseek
ROLE_REASON=deepseek,glm
ROLE_FAST=nemotron,glm

DEEPSEEK_MAX_CONCURRENCY=4
DEEPSEEK_RPS=3
GLM_MAX_CONCURRENCY=4
GLM_RPS=3
NEMOTRON_MAX_CONCURRENCY=8
NEMOTRON_RPS=6

# ---------------- Misc ----------------
SCHEDULER_ENABLED=1
STARTUP_RULE_REFRESH=1
RULE_TTL_HOURS=24
RATE_LIMIT_PER_MIN=120
LOG_LEVEL=INFO
